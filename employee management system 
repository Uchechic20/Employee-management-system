def save_to_json(data: list[dict], filepath: str = EMPLOYEES_FILE):
    with open(filepath, "w") as f:
        json.dump(data, f, indent=4)
    print(f"Saved {len(data)} records to '{filepath}'.")


def load_from_json(filepath: str = EMPLOYEES_FILE) -> list[dict]:
    with open(filepath, "r") as f:
        return json.load(f)


def add_employee_interactive(employees: list[dict], filepath: str = EMPLOYEES_FILE) -> list[dict]:
    """
    Prompts the user for input, validates each field via the Employee setters,
    appends the new record, and immediately saves to JSON.
    """
    print("\n-- Add New Employee --")
    try:
        emp_id          = input("ID: ").strip()
        name            = input("Name: ").strip()
        gender          = input("Gender (male/female): ").strip().lower()
        phone           = input("Phone (11 digits): ").strip()
        email           = input("Email: ").strip()
        department      = input("Department: ").strip()
        role            = input("Role: ").strip()
        employment_type = input("Employment type (Full-time/Part-time/Contract): ").strip()
        age             = int(input("Age: "))
        salary          = float(input("Salary: "))
        hire_date       = input("Hire date (YYYY-MM-DD): ").strip()
        status          = input("Status (active/inactive): ").strip()
        origin          = input("Origin: ").strip()
        marital_status  = input("Marital status: ").strip()
        bank_account    = input("Bank account (10 digits): ").strip()
        tax_id          = input("Tax ID: ").strip()

        validated = FullTimeEmployee(
            emp_id, name, gender, phone, email, department, role,
            employment_type, age, salary, hire_date, status,
            origin, marital_status, bank_account, tax_id,
        )

        employees.append(validated.to_dict())
        save_to_json(employees, filepath)
        print(f"Welcome, {name}! Your value to our growth is inestimable.")

    except (NegativeSalaryError, GenderError, MobileNoError, AgeError, BankNoError) as e:
        print(f"Validation error: {e}")
    except ValueError as e:
        print(f"Input error (age/salary must be numbers): {e}")

    return employees


