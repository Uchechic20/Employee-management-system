# ─────────────────────────────────────────────
#  CUSTOM EXCEPTIONS
# ─────────────────────────────────────────────

class NegativeSalaryError(Exception):
    pass

class GenderError(Exception):
    pass

class MobileNoError(Exception):
    pass

class AgeError(Exception):
    pass

class BankNoError(Exception):
    pass


# ─────────────────────────────────────────────
#  ABSTRACT BASE CLASS
# ─────────────────────────────────────────────

class Employee(ABC):
    """
    Abstract base class that enforces a contract for all employee types.
    Handles validation and encapsulation for shared fields.
    """

    def __init__(self, id, name, gender, phone, email, department, role,
                 employment_type, age, salary, hire_date, status,
                 origin, marital_status, bank_account, tax_id):
        self._id = id
        self.name = name
        self.gender = gender
        self.phone = phone
        self.email = email
        self.department = department
        self.role = role
        self.employment_type = employment_type
        self.age = age
        self.salary = salary
        self.hire_date = hire_date
        self.status = status
        self.origin = origin
        self.marital_status = marital_status
        self.bank_account = bank_account
        self.tax_id = tax_id

    # ── Abstract methods (must be implemented by subclasses) ──

    @abstractmethod
    def calculate_pay(self) -> float:
        """Returns the employee's pay for the period."""
        pass

    @abstractmethod
    def get_role_type(self) -> str:
        """Returns a string describing the employment type."""
        pass

    @abstractmethod
    def display_details(self):
        """Prints a formatted summary of the employee."""
        pass

    # ── ID (read-only) ──

    @property
    def id(self):
        return self._id

    # ── Name ──

    @property
    def name(self):
        return self._name

    @name.setter
    def name(self, value):
        if not value.strip():
            raise ValueError("Name cannot be empty.")
        self._name = value.strip()

    # ── Gender ──

    @property
    def gender(self):
        return self._gender

    @gender.setter
    def gender(self, value):
        if value.strip().lower() not in ("male", "female"):
            raise GenderError(f"Invalid gender: '{value}'. Must be 'male' or 'female'.")
        self._gender = value.strip().lower()

    # ── Phone ──

    @property
    def phone(self):
        return self._phone

    @phone.setter
    def phone(self, value):
        if len(value) != 11 or not value.isdigit():
            raise MobileNoError(f"Invalid phone number: '{value}'. Must be 11 digits.")
        self._phone = value

    # ── Age ──

    @property
    def age(self):
        return self._age

    @age.setter
    def age(self, value):
        if not (18 <= value <= 65):
            raise AgeError(f"Invalid age: {value}. Must be between 18 and 65.")
        self._age = value

    # ── Salary ──

    @property
    def salary(self):
        return self._salary

    @salary.setter
    def salary(self, value):
        try:
            value = float(value)
        except (ValueError, TypeError):
            raise ValueError(f"Salary must be a number, got: '{value}'.")
        if value < 0:
            raise NegativeSalaryError("Salary cannot be negative.")
        self._salary = value

    # ── Bank Account ──

    @property
    def bank_account(self):
        return self._bank_account

    @bank_account.setter
    def bank_account(self, value):
        if len(value) != 10 or not value.isdigit():
            raise BankNoError(f"Invalid bank account: '{value}'. Must be exactly 10 digits.")
        self._bank_account = value

    # ── Shared utility ──

    def to_dict(self) -> dict:
        """Converts the employee to a dictionary for JSON serialisation."""
        return {
            "id": self._id,
            "name": self._name,
            "gender": self._gender,
            "phone": self._phone,
            "email": self.email,
            "department": self.department,
            "role": self.role,
            "employment_type": self.employment_type,
            "age": self._age,
            "salary": self._salary,
            "hire_date": self.hire_date,
            "status": self.status,
            "origin": self.origin,
            "marital_status": self.marital_status,
            "bank_account": self._bank_account,
            "tax_id": self.tax_id,
        }


# ─────────────────────────────────────────────
#  PAY STRATEGY
# ─────────────────────────────────────────────

class PayStrategy(ABC):
    """Abstract pay strategy — decouples pay logic from employee classes."""

    @abstractmethod
    def compute(self, salary: float, **kwargs) -> float:
        pass


class SalariedStrategy(PayStrategy):
    def compute(self, salary: float, tax_rate: float = 0.10, **kwargs) -> float:
        return salary - (salary * tax_rate)


class HourlyStrategy(PayStrategy):
    def compute(self, salary: float, hourly_rate: float = 0,
                hours_worked: float = 0, **kwargs) -> float:
        # `salary` is required by the abstract interface but unused here;
        # hourly pay is entirely determined by rate x hours.
        return hourly_rate * hours_worked


class ContractStrategy(PayStrategy):
    def compute(self, salary: float, daily_rate: float = 0,
                days_worked: int = 0, **kwargs) -> float:
        # `salary` is required by the abstract interface but unused here;
        # contract pay is entirely determined by daily rate x days worked.
        return daily_rate * days_worked


# ─────────────────────────────────────────────
#  CONCRETE EMPLOYEE TYPES
# ─────────────────────────────────────────────

class FullTimeEmployee(Employee):
    """Salaried employee with tax deduction and bonus support."""

    def __init__(self, *args, tax_rate: float = 0.10, bonus_rate: float = 0.10, **kwargs):
        super().__init__(*args, **kwargs)
        self.tax_rate = tax_rate
        self.bonus_rate = bonus_rate
        self._pay_strategy = SalariedStrategy()

    def calculate_pay(self) -> float:
        net = self._pay_strategy.compute(self._salary, tax_rate=self.tax_rate)
        bonus = self._salary * self.bonus_rate if self._salary > 200_000 else 0
        return net + bonus

    def get_role_type(self) -> str:
        return "Full-Time Employee"

    def display_details(self):
        print(
            f"[Full-Time] {self._name} | Dept: {self.department} | "
            f"Role: {self.role} | Net Pay: N{self.calculate_pay():,.2f}"
        )


class PartTimeEmployee(Employee):
    """Hourly employee — pay depends on hours worked."""

    def __init__(self, *args, hourly_rate: float = 0, hours_worked: float = 0, **kwargs):
        super().__init__(*args, **kwargs)
        self.hourly_rate = hourly_rate
        self.hours_worked = hours_worked
        self._pay_strategy = HourlyStrategy()

    def calculate_pay(self) -> float:
        return self._pay_strategy.compute(
            self._salary,
            hourly_rate=self.hourly_rate,
            hours_worked=self.hours_worked,
        )

    def get_role_type(self) -> str:
        return "Part-Time Employee"

    def display_details(self):
        print(
            f"[Part-Time] {self._name} | Dept: {self.department} | "
            f"Hours: {self.hours_worked} | Pay: N{self.calculate_pay():,.2f}"
        )


class Contractor(Employee):
    """Daily-rate contractor."""

    def __init__(self, *args, daily_rate: float = 0, days_worked: int = 0, **kwargs):
        super().__init__(*args, **kwargs)
        self.daily_rate = daily_rate
        self.days_worked = days_worked
        self._pay_strategy = ContractStrategy()

    def calculate_pay(self) -> float:
        return self._pay_strategy.compute(
            self._salary,
            daily_rate=self.daily_rate,
            days_worked=self.days_worked,
        )

    def get_role_type(self) -> str:
        return "Contractor"

    def display_details(self):
        print(
            f"[Contractor] {self._name} | Dept: {self.department} | "
            f"Days: {self.days_worked} | Pay: N{self.calculate_pay():,.2f}"
        )


# ─────────────────────────────────────────────
#  MANAGER HIERARCHY
# ─────────────────────────────────────────────

class Manager(FullTimeEmployee):
    """A full-time employee who leads a team."""

    def __init__(self, *args, team_size: int = 0, **kwargs):
        super().__init__(*args, **kwargs)
        self.team_size = team_size

    def get_role_type(self) -> str:
        return f"Manager (team of {self.team_size})"

    def display_details(self):
        print(
            f"[Manager] {self._name} | Dept: {self.department} | "
            f"Team: {self.team_size} | Net Pay: N{self.calculate_pay():,.2f}"
        )


class ProjectManager(Manager):
    """Manager responsible for a specific project."""

    def __init__(self, *args, project_name: str = "", project_budget: float = 0, **kwargs):
        super().__init__(*args, **kwargs)
        self.project_name = project_name
        self.project_budget = project_budget

    def manage_project(self) -> str:
        return (
            f"{self._name} manages project '{self.project_name}' "
            f"with a budget of N{self.project_budget:,.2f}"
        )

    def get_role_type(self) -> str:
        return f"Project Manager - {self.project_name}"

    def display_details(self):
        print(
            f"[Project Manager] {self._name} | Project: {self.project_name} | "
            f"Budget: N{self.project_budget:,.2f} | Net Pay: N{self.calculate_pay():,.2f}"
        )


# ─────────────────────────────────────────────
#  DEPARTMENT
# ─────────────────────────────────────────────

class Department:
    """Manages a collection of employees using only the Employee interface."""

    def __init__(self, name: str):
        self.name = name
        self._employees: list[Employee] = []

    def add_employee(self, emp: Employee):
        if not isinstance(emp, Employee):
            raise TypeError(f"Expected an Employee instance, got {type(emp).__name__}.")
        self._employees.append(emp)

    def total_payroll(self) -> float:
        return sum(emp.calculate_pay() for emp in self._employees)

    def department_report(self):
        print(f"\n{'─'*50}")
        print(f"  Department: {self.name}")
        print(f"{'─'*50}")
        for emp in self._employees:
            emp.display_details()
        print(f"  Total Payroll: N{self.total_payroll():,.2f}")
        print(f"{'─'*50}\n")


