def run_analytics(filepath: str = EMPLOYEES_FILE):
    df = pd.read_json(filepath)

    print("\n-- Full Employee Table (first 5) --")
    print(df.head())

    df["tax"]         = df["salary"] * 0.10
    df["net_salary"]  = df["salary"] - df["tax"]
    df["performance"] = df["salary"].apply(
        lambda s: "excellent" if s > 200_000 else ("average" if s < 100_000 else "good")
    )
    df["promoted"] = df["salary"] > 150_000
    df.loc[(df["age"] > 60) & (df["status"] == "active"), "status"] = "retired"

    print("\n-- Active Employees --")
    print(df[df["status"] == "active"][["name", "role", "department", "net_salary"]])

    print("\n-- IT Department (salary > 150,000) --")
    print(df[(df["department"] == "IT") & (df["salary"] > 150_000)][["name", "role", "salary"]])

    print("\n-- Employees Under 30 --")
    print(df[df["age"] < 30][["name", "age", "department"]])

    print("\n-- Performance Ratings --")
    print(df[["name", "salary", "performance", "promoted"]])

    print("\n-- Summary --")
    print(f"Total employees : {len(df)}")
    print(f"Total payroll   : {df['net_salary'].sum():,.2f}")
    print(f"Average salary  : {df['salary'].mean():,.2f}")


